<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My First Website</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      background: #f1f0ff;
      color: #29234a;
      padding: 50px 20px;
    }

    .card {
      background: white;
      max-width: 500px;
      margin: auto;
      padding: 35px;
      border-radius: 20px;
      box-shadow: 0 4px 20px #0001;
    }

    button {
      background: #7158e2;
      color: white;
      border: none;
      padding: 13px 22px;
      border-radius: 10px;
      cursor: pointer;
      margin: 8px;
      font-size: 16px;
    }

    button:hover {
      background: #4b36ad;
    }

    a {
      color: #7158e2;
    }
  </style>
</head>

<body>
  <div class="card">
    <h1>Welcome to My Website!</h1>
    <p>This is my first clickable website.</p>

    <button onclick="showMessage()">
      Click Me!
    </button>

    <button onclick="changeColor()">
      Change Background
    </button>

    <p id="message"></p>

    <p>
      <a href="https://github.com/" target="_blank"
         rel="noopener noreferrer">
        Visit GitHub
      </a>
    </p>
  </div>

  <script>
    function showMessage() {
      document.getElementById("message").textContent =
        "You clicked the button! 🎉";
    }

    function changeColor() {
      document.body.style.background =
        document.body.style.background === "lavender"
          ? "#f1f0ff"
          : "lavender";
    }
  </script>
</body>
</html>
